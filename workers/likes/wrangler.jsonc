{
  "name": "xiwu-article-likes",
  "main": "index.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://cloud.xiwu.space",
    "ARTICLE_IDS": "claw-marks,hrt-month-3,hrt-preface,through-time-and-space,xiwu"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiwu-article-likes",
      "database_id": "fe7a7e61-5d8f-4a8b-9b88-0a3fc79a2d0b",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
