diff --git a/dist/motion.css b/dist/motion.css
new file mode 100644
index 0000000..71d24ee
--- /dev/null
+++ b/dist/motion.css
@@ -0,0 +1,19 @@
+/* 轻量动效仅使用 transform / opacity；不会把默认内容设为隐藏。 */
+.cloud-one, .cloud-two { animation:cloud-drift 30s ease-in-out infinite alternate; animation-play-state:paused; }
+.cloud-two { animation-duration:36s; animation-direction:alternate-reverse; }
+.clouds-running .cloud-one, .clouds-running .cloud-two { animation-play-state:running; }
+@keyframes cloud-drift { from { transform:translate3d(0,0,0); } to { transform:translate3d(12px,-8px,0); } }
+.card-button { transition:transform 160ms,box-shadow 160ms,border-color 160ms; }
+.card-button:is(:hover,:focus-visible) { transform:translateY(-2px); border-color:var(--primary); box-shadow:var(--shadow); }
+.card-button:focus-visible .card-more { text-decoration:underline; text-underline-offset:4px; }
+.card-enter { animation:card-enter 280ms ease-out both; }
+@keyframes card-enter { from { opacity:.35; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
+dialog[open] { animation:dialog-enter 180ms ease-out; }
+@keyframes dialog-enter { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
+.music-panel:not([hidden]) { animation:music-enter 180ms ease-out; }
+@keyframes music-enter { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
+@media(prefers-reduced-motion:reduce) {
+  .cloud, .card-enter, dialog[open], .music-panel:not([hidden]) { animation:none!important; }
+  .card-button { transition:none; }
+  .card-button:is(:hover,:focus-visible), .card-button:is(:hover,:focus-visible) img, .hero-button:hover { transform:none; }
+}
diff --git a/dist/motion.js b/dist/motion.js
new file mode 100644
index 0000000..d7a424f
--- /dev/null
+++ b/dist/motion.js
@@ -0,0 +1,38 @@
+// 渐进增强：正文默认可见，观察器失败或没有脚本也不阻断阅读。
+(() => {
+  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
+  const hero = document.querySelector('.hero');
+  const grid = document.querySelector('.interest-grid');
+  if (!('IntersectionObserver' in window)) return;
+  let heroVisible = false;
+  const seen = new Set();
+  const syncClouds = () => document.documentElement.classList.toggle('clouds-running', heroVisible && !document.hidden && !reduced.matches);
+  if (hero) {
+    new IntersectionObserver(entries => {
+      heroVisible = entries[0].isIntersecting;
+      syncClouds();
+    }).observe(hero);
+    document.addEventListener('visibilitychange', syncClouds);
+  }
+  const cards = new IntersectionObserver(entries => {
+    for (const {target, isIntersecting} of entries) {
+      if (!isIntersecting) continue;
+      const id = target.dataset.essayId;
+      if (!reduced.matches && !seen.has(id)) target.classList.add('card-enter');
+      seen.add(id);
+      cards.unobserve(target);
+    }
+  }, {threshold:0.08});
+  const observeCards = () => grid?.querySelectorAll('.interest-card').forEach(card => cards.observe(card));
+  observeCards();
+  if (grid) new MutationObserver(records => {
+    for (const record of records) for (const node of record.removedNodes) {
+      if (node.nodeType === 1) cards.unobserve(node);
+    }
+    observeCards();
+  }).observe(grid, {childList:true});
+  reduced.addEventListener('change', () => {
+    syncClouds();
+    if (reduced.matches) document.querySelectorAll('.card-enter').forEach(card => card.classList.remove('card-enter'));
+  });
+})();
